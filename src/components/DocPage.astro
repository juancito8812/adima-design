---
/**
 * Shared shell for text-heavy pages (legal, privacy).
 * Same rail + footer as the rest of the site so nothing feels bolted on.
 */
import Rail from './Rail.astro';
import Base from '../layouts/Base.astro';
import { site, url } from '../config';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lead?: string;
  active?: string;
}

const { title, description, eyebrow, heading, lead, active = '' } = Astro.props;
const waLink = `${site.social.whatsapp}?text=${encodeURIComponent(
  'Hi Adima Design, I have a question about your terms.'
)}`;
---

<Base title={title} description={description} active={active}>
  <Rail />

  <main class="main" id="main" tabindex="-1">
    <section class="block">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      {lead && <p class="big doc-lead">{lead}</p>}
      <div class="doc">
        <slot />
      </div>
    </section>
  </main>

  <footer class="foot">
    <span>© {new Date().getFullYear()} {site.name} · {site.tagline}</span>
    <span class="social">
      <a href={url('/legal')}>Legal</a>
      <a href={url('/privacy')}>Privacy</a>
      <a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a>
      <a href={waLink} target="_blank" rel="noopener">WhatsApp</a>
    </span>
  </footer>
</Base>