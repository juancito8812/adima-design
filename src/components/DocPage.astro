---
/**
 * Shared shell for text-heavy pages (legal, privacy).
 * Same rail + footer as the rest of the site so nothing feels bolted on.
 */
import Base from '../layouts/Base.astro';
import { site, url } from '../config';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lead?: string;
  active?: string;
}

const { title, description, eyebrow, heading, lead, active = '' } = Astro.props;
const waLink = `${site.social.whatsapp}?text=${encodeURIComponent(
  'Hi Adima Design, I have a question about your terms.'
)}`;
---

<Base title={title} description={description} active={active}>
  <aside class="rail">
    <div>
      <a class="brand" href={url('/')}>
        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <rect x="4" y="4" width="56" height="56" stroke="#e4e4e4" />
          <path d="M20 46 L32 18 L44 46" />
          <path d="M25 36 H39" />
        </svg>
        <span class="brand-name">{site.name}</span>
        <span class="brand-sub">{site.tagline}</span>
      </a>

      <nav class="nav" aria-label="Main">
        <a href={url('/')}>Home</a>
        <a href={url('/projects')}>Portfolio</a>
        <a href={url('/#servicios')}>Services</a>
        <a href={url('/#estudio')}>Studio</a>
        <a href={url('/#testimonials')}>Testimonials</a>
        <a href={url('/legal')} aria-current={active === 'legal' ? 'true' : undefined}>Legal</a>
        <a href={url('/privacy')} aria-current={active === 'privacy' ? 'true' : undefined}>Privacy</a>
        <a href={url('/#contacto')}>Contact</a>
      </nav>
    </div>

    <div class="rail-foot">
      {site.street}<br />
      {site.city}<br />
      <a href={`mailto:${site.email}`}>{site.email}</a><br />
      <a href={waLink} target="_blank" rel="noopener">{site.phone}</a>
    </div>
  </aside>

  <main class="main" id="main" tabindex="-1">
    <section class="block">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      {lead && <p class="big doc-lead">{lead}</p>}
      <div class="doc">
        <slot />
      </div>
    </section>
  </main>

  <footer class="foot">
    <span>© {new Date().getFullYear()} {site.name} · {site.tagline}</span>
    <span class="social">
      <a href={url('/legal')}>Legal</a>
      <a href={url('/privacy')}>Privacy</a>
      <a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a>
      <a href={waLink} target="_blank" rel="noopener">WhatsApp</a>
    </span>
  </footer>
</Base>
