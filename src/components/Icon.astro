---
interface Props {
  name: string;
  size?: number;
}

const { name, size = 58 } = Astro.props;

// Iconos de línea fina (trazo 1), dibujados en un lienzo de 24×24 y centrados
// dentro del círculo. Mismo lenguaje gráfico en todo el sitio.
const icons: Record<string, string> = {
  plan: '<path d="M3 3h18v18H3z"/><path d="M3 11h18M12 11v10"/><path d="M15 15h3"/>',
  wall: '<path d="M3 3h18v18H3z"/><path d="M3 9h18M3 15h18M9 3v6M15 9v6M9 15v6"/>',
  layers: '<path d="M12 2.5 21 7.5 12 12.5 3 7.5z"/><path d="M3 12.5 12 17.5l9-5"/><path d="M3 17 12 22l9-5"/>',
  drop: '<path d="M12 2.5c3.6 4.1 6 7.4 6 10.6a6 6 0 0 1-12 0C6 9.9 8.4 6.6 12 2.5z"/><path d="M12 18.5v-5"/>',
  crane: '<path d="M2 22V5h14l5 5"/><path d="M6 22v-9h6v9"/><path d="M5 5h16"/><path d="M21 10v5"/>',
  roller: '<path d="M4 4h13v5H4z"/><path d="M9 9v3h5v9"/><path d="M7 4V2h7v2"/>',
  lamp: '<path d="M11 2v5"/><path d="M5 7h13l3 6H2z"/><path d="M11 13v7"/><path d="M7 20h8"/>',
  check: '<path d="M11 2l8 4v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M7 11l3 3 5-6"/>',
  doc: '<path d="M4 2h9l5 5v15H4z"/><path d="M13 2v5h5"/><path d="M8 12h8M8 16h8M8 19h5"/>',
  instagram:
    '<rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.4"/><circle cx="16.4" cy="7.6" r="0.9"/>',
  youtube: '<rect x="3" y="5" width="18" height="14" rx="3.5"/><path d="M10.5 9.2l5 2.8-5 2.8z"/>',
  whatsapp:
    '<path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3z"/><path d="M8.6 9c0 3.1 2.3 5.4 5.4 5.4"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.6 6.6 12 13l8.4-6.4"/>',
};

const filled = name === 'youtube';
const path = icons[name] ?? icons.doc;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 38 38"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <circle cx="19" cy="19" r="18" stroke="#dcdcd8" stroke-width="1" />
  <g transform="translate(7 7) translate(12 12) scale(0.93) translate(-12 -12)" fill={filled ? 'currentColor' : 'none'} stroke={filled ? 'none' : 'currentColor'}>
    <g set:html={path} />
  </g>
</svg>
