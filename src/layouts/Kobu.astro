---
import Base from './Base.astro';
import { site, url } from '../config';
import '../styles/kobu.css';

interface Props {
  title?: string;
  description?: string;
  active?: string;
}

const { title, description, active = 'home' } = Astro.props;

const waLink = `${site.social.whatsapp}?text=${encodeURIComponent(
  'Hi Adima Design, I would like a quote for a project.'
)}`;

const links = [
  { label: 'Services', href: '/#servicios' },
  { label: 'Work', href: '/#proyectos' },
  { label: 'Studio', href: '/#estudio' },
  { label: 'Journal', href: '/journal' },
  { label: 'Contact', href: '/#contacto' },
];
---

<Base title={title} description={description} active={active}>
  <header class="kb">
    <div class="kb-in">
      <nav class="kb-links" aria-label="Main">
        {links.slice(0, 3).map((l) => <a href={url(l.href)}>{l.label}</a>)}
      </nav>

      <a class="kb-mark" href={url('/')} aria-label={`${site.name} — home`}>
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <rect x="5" y="5" width="54" height="54" />
          <path d="M20 46 L32 18 L44 46" />
          <path d="M25 36 H39" />
        </svg>
        <span>{site.wordmark}</span>
      </a>

      <div class="kb-right">
        <a href={url('/projects')}>Portfolio</a>
        <a href={url('/journal')}>Journal</a>
        <a href={waLink} target="_blank" rel="noopener">Quote ↗</a>
      </div>
    </div>
  </header>

  <slot />

  <footer class="kf">
    <div class="wrap kf-in">
      <span class="mono mono-sm">© {new Date().getFullYear()} {site.name}</span>
      <nav class="kf-links">
        <a class="mono mono-sm" href={url('/legal')}>Legal</a>
        <a class="mono mono-sm" href={url('/privacy')}>Privacy</a>
        <a class="mono mono-sm" href={site.social.instagram} target="_blank" rel="noopener">Instagram</a>
        <a class="mono mono-sm" href={waLink} target="_blank" rel="noopener">WhatsApp</a>
      </nav>
      <span class="mono mono-sm mono-ash">{site.serviceArea}</span>
    </div>
  </footer>
</Base>
