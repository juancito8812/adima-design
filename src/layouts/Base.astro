---
import '../styles/global.css';
import { site, url } from '../config';

interface Props {
  title?: string;
  description?: string;
  /** Marks the active menu item (internal pages). */
  active?: string;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
  active = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('/og-image.jpg'), Astro.site);

/* LocalBusiness: only facts already confirmed by the client.
   No openingHoursSpecification: hours are by appointment, and a 24/7 block is
   a claim we cannot back. */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: site.name,
  description: site.description,
  url: new URL(url('/'), Astro.site).toString(),
  image: ogImage.toString(),
  logo: new URL(url('/icon-512.png'), Astro.site).toString(),
  email: site.email,
  telephone: `+${site.whatsapp}`,
  priceRange: '$$$',
  areaServed: [
    { '@type': 'City', name: 'Miami' },
    { '@type': 'City', name: 'Doral' },
    { '@type': 'City', name: 'Hialeah' },
    { '@type': 'City', name: 'Fort Lauderdale' },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    addressLocality: 'Hollywood',
    addressRegion: 'FL',
    postalCode: '33021',
    addressCountry: 'US',
  },
  sameAs: [site.social.instagram],
  knowsAbout: ['Venetian plaster', 'Microcement', 'Marmorino', 'Limewash', 'Epoxy resin', 'Interior design'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="icon" href={url('/icon-192.png')} sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — interior finishes in Miami`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body data-active={active}>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
