---
import Nice from '../layouts/Nice.astro';
import {
  site,
  url,
  stats,
  services,
  about,
  process,
  portfolio,
  founder,
  distinction,
  reviews,
  commitments,
} from '../config';

const bySlug = (slug: string) => portfolio.find((p) => p.slug === slug)!;
const srcset = (slug: string) =>
  [480, 960, 1600].map((w) => `${url(`/portfolio/${slug}-${w}.webp`)} ${w}w`).join(', ');

const waLink = `${site.social.whatsapp}?text=${encodeURIComponent(
  'Hi Adima Design, I would like a quote for a project.'
)}`;

/** Photo used on each service card. */
const serviceShots = ['marble-hallway', 'texture-microcement', 'epoxy-living-room'];

const gallery = [
  'univista-lobby',
  'marble-bathroom',
  'panel-wall',
  'pool-fire-feature',
  'univista-reception',
  'garage-flake-floor',
].map(bySlug);
---

<Nice active="home">
  <main class="page" id="main" tabindex="-1">
    <!-- Hero: foto full-bleed + titular centrado (patrón de la plantilla) -->
    <section
      class="hero"
      id="inicio"
      style={`--hero-img: url(${url('/portfolio/univista-lobby-1600.webp')})`}
    >
      <div class="hero-in">
        <p class="eyebrow">Interior finishes · {site.serviceArea}</p>
        <h1>Surfaces with depth, applied layer by layer.</h1>
        <p>
          Venetian plaster, microcement, Marmorino and epoxy resin for homes and businesses across
          South Florida — hand-applied, sealed and built to last.
        </p>
        <div class="hero-actions">
          <a class="btn btn-blue" href={waLink} target="_blank" rel="noopener">Request a quote</a>
          <a class="btn btn-ghost" href={url('/projects')}>See our work</a>
        </div>
      </div>
    </section>

    <!-- Cuatro tarjetas blancas redondeadas montadas sobre el hero -->
    <section class="stats" aria-label="At a glance">
      <div class="wrap">
        <div class="stats-grid">
          {stats.map((s) => (
            <div class="stat">
              <b>{s.value}</b>
              <span>{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Servicios -->
    <section class="sec" id="servicios">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">What we do</p>
          <h2>Four techniques, one standard of finish.</h2>
          <p>
            Every surface starts with a sample board you approve before we touch the wall, the floor
            or the ceiling.
          </p>
        </div>

        <div class="cards3">
          {services.map((s, i) => {
            const shot = bySlug(serviceShots[i]);
            return (
              <article class="scard">
                <figure>
                  <img
                    src={url(`/portfolio/${shot.slug}-960.webp`)}
                    srcset={srcset(shot.slug)}
                    sizes="(max-width: 640px) 100vw, (max-width: 980px) 50vw, 33vw"
                    width="960"
                    height="720"
                    alt={`${shot.title} — ${shot.finish}`}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
                <div class="scard-body">
                  <h3>{s.title}</h3>
                  <ul>
                    {s.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  <a class="link-blue" href={waLink} target="_blank" rel="noopener">
                    Ask about this finish →
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Estudio / enfoque -->
    <section class="sec sec-soft" id="estudio">
      <div class="wrap split">
        <figure>
          <img
            src={url('/portfolio/brand-cube-960.webp')}
            srcset={srcset('brand-cube')}
            sizes="(max-width: 980px) 100vw, 50vw"
            width="960"
            height="652"
            alt="Venetian plaster sample board by Adima Design"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div>
          <p class="kicker">{distinction.eyebrow}</p>
          <h2>{distinction.title}</h2>
          <p>{about[0]}</p>
          <p>{distinction.text}</p>
          <ul class="chips">
            {distinction.items.map((i) => (
              <li>{i.title}</li>
            ))}
            {commitments.slice(0, 2).map((c) => (
              <li>{c.title}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Proceso -->
    <section class="sec" id="proceso">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">How we work</p>
          <h2>Four steps, written down before we start.</h2>
        </div>
        <div class="steps">
          {process.map((p) => (
            <article class="step">
              <b>{p.step}</b>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Trabajos -->
    <section class="sec sec-soft" id="proyectos">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">Selected work</p>
          <h2>Rooms we finished in South Florida.</h2>
          <p>Doral · Miami · Hialeah · Fort Lauderdale — commercial and residential.</p>
        </div>
        <div class="gal">
          {gallery.map((p) => (
            <a href={url('/projects')}>
              <figure class="gal-fig">
                <img
                  src={url(`/portfolio/${p.slug}-960.webp`)}
                  srcset={srcset(p.slug)}
                  sizes="(max-width: 640px) 100vw, (max-width: 980px) 50vw, 33vw"
                  width="960"
                  height="720"
                  alt={`${p.title} — ${p.finish}`}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>
                  {p.title}
                  <em>
                    {p.finish} · {p.place}
                  </em>
                </figcaption>
              </figure>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Testimonios (solo se publica cuando haya reseñas reales en config.ts) -->
    {
      reviews.length > 0 && (
        <section class="sec" id="testimonios">
          <div class="wrap">
            <div class="sec-head">
              <p class="eyebrow">What clients say</p>
              <h2>A finish you can live with.</h2>
            </div>
            <div class="quotes">
              {reviews.slice(0, 3).map((r) => (
                <blockquote class="quote">
                  <p>{r.quote}</p>
                  <footer>
                    {r.name}
                    <span>{r.detail}</span>
                  </footer>
                </blockquote>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- CTA -->
    <section class="cta" id="contacto">
      <div class="cta-in">
        <div>
          <h2>Tell us the room, we will tell you the finish.</h2>
          <p>
            {site.phone} · {site.email} · {site.hours}
          </p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-white" href={waLink} target="_blank" rel="noopener">WhatsApp us</a>
          <a class="btn btn-ghost" href={`tel:+${site.whatsapp}`}>Call now</a>
        </div>
      </div>
    </section>

    <p class="credit">{founder.name} — {founder.role}</p>
  </main>
</Nice>
