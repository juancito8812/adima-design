---
import Kobu from '../layouts/Kobu.astro';
import {
  site,
  url,
  services,
  about,
  process,
  portfolio,
  distinction,
  commitments,
} from '../config';

const bySlug = (slug: string) => portfolio.find((p) => p.slug === slug)!;
const srcset = (slug: string) =>
  [480, 960, 1600].map((w) => `${url(`/portfolio/${slug}-${w}.webp`)} ${w}w`).join(', ');

const waLink = `${site.social.whatsapp}?text=${encodeURIComponent(
  'Hi Adima Design, I would like a quote for a project.'
)}`;

const hero = bySlug('panel-wall');

/** Collage asimétrico: primera pieza ancha con etiqueta FEATURED. */
const work = [
  { slug: 'univista-lobby', wide: true, badge: 'Featured', offset: false },
  { slug: 'marble-bathroom', wide: false, badge: null, offset: false },
  { slug: 'panel-wall', wide: false, badge: null, offset: true },
  { slug: 'epoxy-living-room', wide: false, badge: 'New', offset: false },
  { slug: 'pool-fire-feature', wide: false, badge: null, offset: true },
  { slug: 'marble-hallway', wide: false, badge: null, offset: false },
].map((w) => ({ ...w, p: bySlug(w.slug) }));
---

<Kobu active="home">
  <main class="kpage" id="main" tabindex="-1">
    <!-- Wordmark gigante: la marca es el hero, no un logo en una esquina -->
    <section class="khero" id="inicio">
      <div class="wrap">
        <div class="khero-eyebrow">
          <span class="mono">Interior finishes · Est. Hollywood, FL</span>
          <span class="mono mono-ash">{site.serviceArea}</span>
        </div>

        <h1 class="wordmark">ADIMA</h1>
        <hr class="khero-rule" />

        <div class="khero-copy">
          <h2>Venetian plaster, microcement and epoxy — applied by hand, layer by layer.</h2>
          <div>
            <p>
              A South Florida studio working on walls, floors and ceilings for homes, offices and
              hospitality. Lime, marble dust and mineral pigments; sample boards approved before the
              first coat.
            </p>
            <div class="meta">
              <span class="mono mono-ash">01 — Microcement</span>
              <span class="mono mono-ash">02 — Venetian plaster</span>
              <span class="mono mono-ash">03 — Epoxy</span>
            </div>
          </div>
        </div>
      </div>

      <figure class="kfigure">
        <img
          src={url(`/portfolio/${hero.slug}-1600.webp`)}
          srcset={srcset(hero.slug)}
          sizes="100vw"
          width="1600"
          height="1200"
          alt={`${hero.title} — ${hero.finish}`}
          loading="eager"
          decoding="async"
        />
        <span class="badge">In progress · Doral</span>
      </figure>
      <div class="wrap kfigcap">
        <span class="mono mono-ash">{hero.title} — {hero.finish}</span>
        <span class="mono mono-ash">{hero.place}</span>
      </div>
    </section>

    <!-- Trabajos seleccionados: collage editorial -->
    <section class="ksec" id="proyectos">
      <div class="wrap">
        <div class="ksec-head">
          <h2>Selected surfaces</h2>
          <a class="link-more" href={url('/projects')}>All work ↗</a>
        </div>

        <div class="collage">
          {work.map((w) => (
            <article class={`proj${w.wide ? ' wide' : ''}${w.offset ? ' offset' : ''}`}>
              <a href={url('/projects')}>
                <figure>
                  <img
                    src={url(`/portfolio/${w.p.slug}-960.webp`)}
                    srcset={srcset(w.p.slug)}
                    sizes={w.wide ? '(max-width: 900px) 100vw, 800px' : '(max-width: 900px) 50vw, 400px'}
                    width="960"
                    height="720"
                    alt={`${w.p.title} — ${w.p.finish}`}
                    loading="lazy"
                    decoding="async"
                  />
                  {w.badge && <span class="badge">{w.badge}</span>}
                </figure>
                <p class="proj-title">{w.p.title}</p>
                <div class="proj-meta">
                  <span class="mono mono-sm mono-ash">{w.p.finish}</span>
                  <span class="mono mono-sm">{w.p.place}</span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Servicios como filas tipográficas, sin tarjetas -->
    <section class="ksec" id="servicios">
      <div class="wrap">
        <div class="ksec-head">
          <h2>Techniques</h2>
          <span class="mono mono-ash">Three families · one standard</span>
        </div>

        <div class="rows">
          {services.map((s, i) => (
            <article class="row">
              <span class="mono mono-ash">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <ul>
                {s.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Estudio -->
    <section class="ksec" id="estudio">
      <div class="wrap kstudio">
        <figure>
          <img
            src={url('/portfolio/texture-limewash-960.webp')}
            srcset={srcset('texture-limewash')}
            sizes="(max-width: 900px) 100vw, 520px"
            width="960"
            height="720"
            alt="Limewash brushed finish sample"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div>
          <p class="mono mono-ash" style="margin-bottom:.9rem">{distinction.eyebrow}</p>
          <h2>{distinction.title}</h2>
          <p>{about[0]}</p>
          <p>{distinction.text}</p>
          <ul class="tags">
            {distinction.items.map((i) => (
              <li class="badge" style="position:static">{i.title}</li>
            ))}
            {commitments.slice(0, 2).map((c) => (
              <li class="badge" style="position:static">{c.title}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Proceso -->
    <section class="ksec" id="proceso">
      <div class="wrap">
        <div class="ksec-head">
          <h2>Method</h2>
          <span class="mono mono-ash">Written scope before the first coat</span>
        </div>
        <div class="ksteps">
          {process.map((p) => (
            <article class="kstep">
              <span class="mono mono-ash">{p.step}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section class="kcontact wrap" id="contacto">
      <div>
        <h2>Tell us the room, we will tell you the finish.</h2>
        <p>{site.street} · {site.city} · {site.hours}</p>
      </div>
      <dl>
        <div>
          <dt>Phone</dt>
          <dd><a href={`tel:+${site.whatsapp}`}>{site.phone}</a></dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
      </dl>
      <dl>
        <div>
          <dt>WhatsApp</dt>
          <dd><a href={waLink} target="_blank" rel="noopener">Message the studio ↗</a></dd>
        </div>
        <div>
          <dt>Instagram</dt>
          <dd><a href={site.social.instagram} target="_blank" rel="noopener">@adima.design ↗</a></dd>
        </div>
      </dl>
    </section>
  </main>
</Kobu>
