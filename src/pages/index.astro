---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, url, nav, stats, services, about, process, projects } from '../config';

const waLink = `${site.social.whatsapp}?text=${encodeURIComponent(
  'Hi Adima Design, I would like a quote for a project.'
)}`;
---

<Base>
  <aside class="rail">
    <div>
      <a class="brand" href={url('/')}>
        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true">
          <path d="M32 5 L55 19 L55 45 L32 59 L9 45 L9 19 Z" />
          <circle cx="32" cy="30" r="8" />
          <path d="M24 42 L32 34 L40 42" />
        </svg>
        <span class="brand-name">{site.name}</span>
        <span class="brand-sub">{site.tagline}</span>
      </a>

      <nav class="nav" aria-label="Main">
        {nav.map((item) => <a href={url(item.href)} data-hash={item.hash}>{item.label}</a>)}
      </nav>

      <span class="badge">{'AD—\n—IMA\nM1AMI'}</span>
    </div>

    <div class="rail-foot">
      <a href={site.social.instagram} target="_blank" rel="noopener">
        <Icon name="instagram" size={26} />
      </a>
      <a href={waLink} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={26} />
      </a>
      <a href={site.social.instagram} target="_blank" rel="noopener">@adima.design</a>
    </div>
  </aside>

  <main class="main">
    <section class="block" id="inicio">
      <h1>Surfaces with depth, applied layer by layer</h1>

      <div class="col">
        <p class="lead">
          Adima Design creates decorative finishes for interiors: venetian plaster, microcement,
          limewash and epoxy. Residential and commercial spaces across South Florida.
        </p>
        <p>
          We test the finish on a sample board, prepare the surface properly and apply every coat by
          hand. The result is a seamless wall or floor with real depth — not a printed imitation of
          one.
        </p>
        <div class="more-row">
          <a class="more" href={url('/#servicios')}>Services</a>
          <a class="more" href={url('/#contacto')}>Request a quote</a>
        </div>
      </div>

      <figure class="media media-lg ratio-32">
        <figcaption class="media-tag">Main image pending</figcaption>
      </figure>
    </section>

    <section class="block" id="servicios">
      <h2>Finishes</h2>

      <div class="services">
        {services.map((s) => (
          <article class="service">
            <div class="tile"><Icon name={s.icon} size={46} /></div>
            <div>
              <span class="service-label">{s.title}</span>
              <span class="service-note">{s.items.join(' · ')}</span>
            </div>
          </article>
        ))}
      </div>

      <p class="todo">Demo content · photos and final contact details pending.</p>
    </section>

    <section class="block" id="proyectos">
      <h2>Recent work</h2>

      <div class="projects">
        {projects.map((p) => (
          <figure class="project">
            <div class={`media ${p.ratio}`}>
              <span class="media-tag">Photo pending</span>
            </div>
            <figcaption>({p.title} · {p.type})</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="block" id="estudio">
      <h2>Studio</h2>

      <div class="study">
        <div class="col">
          {about.map((paragraph) => <p>{paragraph}</p>)}
          <div class="facts">
            {stats.map((s) => (
              <div><strong>{s.value}</strong> · {s.label}</div>
            ))}
          </div>
        </div>

        <div class="study-media">
          <figure>
            <div class="media ratio-43"><span class="media-tag">Application photo pending</span></div>
            <figcaption>(On-site application · sheen check)</figcaption>
          </figure>
          <figure>
            <div class="media ratio-43"><span class="media-tag">Crew photo pending</span></div>
            <figcaption>(Our crew · {site.address})</figcaption>
          </figure>
        </div>
      </div>

      <div class="process">
        {process.map((p) => (
          <div>
            <b>{p.step}</b>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="block" id="contacto">
      <h2>Contact</h2>

      <div class="contact">
        <div>
          <dl class="dl">
            <div><dt>Phone</dt><dd>{site.phone}</dd></div>
            <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
            <div><dt>Instagram</dt><dd><a href={site.social.instagram} target="_blank" rel="noopener">@adima.design</a></dd></div>
            <div><dt>Location</dt><dd>{site.address}</dd></div>
            <div><dt>Hours</dt><dd>{site.hours}</dd></div>
          </dl>
          <p class="todo">Email, street address and hours still to be confirmed by the client.</p>
        </div>

        <form id="contact-form" novalidate>
          <label class="field">
            <span>Full name</span>
            <input type="text" name="nombre" autocomplete="name" required />
          </label>
          <label class="field">
            <span>Phone or email</span>
            <input type="text" name="contacto" autocomplete="tel" required />
          </label>
          <label class="field">
            <span>Project type</span>
            <select name="tipo">
              <option value="">Select an option</option>
              <option>Venetian plaster</option>
              <option>Microcement</option>
              <option>Limewash / accent wall</option>
              <option>Epoxy &amp; wood panels</option>
              <option>Bathroom / wet area</option>
              <option>Interior design</option>
              <option>Other</option>
            </select>
          </label>
          <label class="field">
            <span>Project details</span>
            <textarea name="mensaje" rows="4"></textarea>
          </label>
          <button class="submit" type="submit">Send request</button>
          <p id="form-status" class="todo" style="display:none"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="foot">
    <span>© {new Date().getFullYear()} {site.name}</span>
    <span class="social">
      <a href={site.social.instagram} target="_blank" rel="noopener">
        <Icon name="instagram" size={22} />Instagram
      </a>
      <a href={waLink} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={22} />WhatsApp
      </a>
      <a href={`mailto:${site.email}`}><Icon name="mail" size={22} />Email</a>
    </span>
  </footer>

  <script>
    // Menu: highlights the visible section (same behaviour as the reference site).
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav a'));
    const sections = links
      .map((link) => document.getElementById(link.dataset.hash ?? ''))
      .filter((el): el is HTMLElement => Boolean(el));

    const setActive = (id: string) => {
      links.forEach((link) => {
        if (link.dataset.hash === id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible?.target.id) setActive(visible.target.id);
        },
        { rootMargin: '-20% 0px -55% 0px', threshold: [0.05, 0.25, 0.5] }
      );
      sections.forEach((section) => observer.observe(section));
    }

    // Demo form: no backend configured yet.
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status') as HTMLElement | null;
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!status) return;
      status.style.display = 'block';
      status.textContent =
        'Demo form: no submission service configured yet. Please reach us on Instagram or WhatsApp.';
    });
  </script>
</Base>
